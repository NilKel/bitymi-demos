# Heavy bundled scenes — keep them OUT of git. >100 MB blobs would be
# rejected by the GitHub Pages branch anyway. We host them as Release
# assets (gh release upload …); index.html links to the Releases CDN URL.
scenes/*.bitymi
scenes/*.ply
scenes/*.npz
scenes/*.nat2
scenes/*.bc7
