 // Stubs kept for legacy splat-app.ts callers. We don't use SH degree under SV.
+/** FETCHBENCH: number of EXTRA per-fragment atlas fetches (0..3), packed into
+ *  accel_flags bits 16..17 (read by render_2dgs.wgsl; ignored by cull/preprocess). */
+export function setExtraFetches(n: number, device?: GPUDevice, buffer?: GPUBuffer, commit: boolean = true) {
+  const f = RenderSettingsViews.accel_flags[0] & ~(3 << 16);
+  RenderSettingsViews.accel_flags[0] = (f | ((Math.max(0, Math.min(3, n | 0)) & 3) << 16)) >>> 0;
+  flush(device ?? null, buffer ?? null, commit);
+}
+export function getExtraFetches(): number { return (RenderSettingsViews.accel_flags[0] >>> 16) & 3; }
